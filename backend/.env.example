# Database
DATABASE_URL=postgresql+asyncpg://helmos:helmos_pass@postgres:5432/helmos
SYNC_DATABASE_URL=postgresql+psycopg2://helmos:helmos_pass@postgres:5432/helmos

# Redis
REDIS_URL=redis://redis:6379/0

# App
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# HelmOS Memory Sandbox integration (optional — personalization context
# lookups no-op if either is unset; see app/services/sandbox_client.py)
SANDBOX_API_URL=http://127.0.0.1:8000
SANDBOX_SERVICE_TOKEN=
